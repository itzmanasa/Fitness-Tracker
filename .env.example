# MySQL runtime configuration (these accounts are used by the backend only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fittrack_db
DB_RUNTIME_USER=ft_member
DB_RUNTIME_PASSWORD=choose_a_strong_member_runtime_password
DB_CREDENTIAL_USER=ft_credential
DB_CREDENTIAL_PASSWORD=choose_a_strong_credential_password
DB_ADMIN_API_USER=ft_api_admin
DB_ADMIN_API_PASSWORD=choose_a_strong_admin_api_password

# Keep DB_MIGRATION_USER / DB_MIGRATION_PASSWORD in database/.env.migration.
# Keep DB_BOOTSTRAP_USER / DB_BOOTSTRAP_PASSWORD and the ft_admin credential
# outside the backend environment in database/.env.bootstrap. Both files are git-ignored.

# Memurai / Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis ACL user (database/demo/09_redis_acl.sh)
REDIS_USERNAME=ft_redis_member
REDIS_MEMBER_PASSWORD=choose_a_strong_redis_password

# Application Secrets
JWT_SECRET=development_secret_key_change_in_production
PORT=5000

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Set deployed frontend origin(s) here outside local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo login is disabled unless explicitly enabled for a local demonstration.
DEMO_LOGIN_ENABLED=false
DEMO_USER_EMAIL=demo@fittrack.com
